{
  "name": "@local/dsh-plugin-market-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "插件市场 Pro：浏览/安装 DSH 插件，详情含长说明、AI 评估与平替；并提供本地插件版本、GitHub 上传与市场发布工作台。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "publisher.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
